# 复制本文件为 .env 后填入真实密钥：cp .env.example .env
# .env 已被 .gitignore 排除，.env.example 作为字段说明入库。
# 不填任何密钥也能完整演示：导购走本地知识库，视觉走内置示例场景，顶栏会显示当前模式。

# ================= 密钥（唯一必填的部分）=================

# ---- 导购大模型（OpenAI 兼容协议，DeepSeek / 通义 / OpenAI 通用）----
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash

# ---- 视觉大模型（通义千问，OpenAI 兼容协议）----
# 模型名示例：qwen3.7-flash / qwen-vl-max-latest / qwen-vl-plus-latest。
# 注意：不同模型需要的开通权限不同，qwen-vl 系列若未开通会返回 403 access_denied。
# 密钥留空时，拍照识别会如实失败并引导人工录入，不会用示例数据顶替。
VISION_API_KEY=your-dashscope-api-key
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen3.7-flash

# ================= 以下均为可选项，注释掉即用代码默认值 =================

# ---- 级联识别：YOLO 出真实框 + 视觉大模型判类别 ----
# off  = 只用视觉大模型（检测框是按数量均分的占位框）
# yolo = 先用 YOLO 圈出商品位置，裁剪后再交给视觉大模型认品类
# 未装 ultralytics 或权重缺失时自动回退整图识别，不会让识别能力下降。
# DETECTOR=off
# YOLO_WEIGHTS=models/yolov8n.pt
# YOLO_CONF=0.12             # 0.30 会挡掉多数真实框；低分垃圾框由级联丢弃，代价只是多一次视觉调用
# YOLO_NMS_IOU=0.55          # 跨类 NMS：COCO 权重常把同一物体框两次，而按类 NMS 并不合并
# YOLO_MAX_BOXES=8
# CASCADE_FULLFRAME_FALLBACK=true   # 框数过少时整帧补读一遍，兜住 YOLO 漏框
# CASCADE_FULLFRAME_TRIGGER=2

# ---- 尺子比例尺：区分同款不同规格（如乐事 70g / 40g）----
# 画面里放一把尺子，每帧让视觉模型读刻度算出 px_per_cm，
# 再用 YOLO 框像素 ÷ px_per_cm 得到商品外尺寸，与库里的 pkg_*_cm 比对。
# 演示级方案：只用「商品长度 vs 尺子比例尺」判断，不引入复杂标定。
# RULER_ENABLED=true
# RULER_LENGTH_CM=15.0        # 仅用于日志核对；换算始终用当帧读到的刻度
# RULER_LENGTH_WEIGHT=0.6     # 长度贴近度最多抵消 60% 的视觉置信度差距

# ---- 识别阈值 ----
# AUTO_ACCEPT_SCORE=0.88      # 高于此分直接入账
# CLARIFY_SCORE=0.55          # 低于此分转人工复核，中间区间主动追问
# SINGLE_CANDIDATE_SCORE=0.72 # 没有可混淆候选时放宽，不必打扰顾客
# WEIGHT_TOLERANCE_G=25.0     # 重量校验容差（克）
# TRAY_TARE_G=0.0             # 托盘皮重；演示场景填净重时保持 0

# ---- 后台看板鉴权 ----
# 留空：dev 演示态全开放。设值：开启 Bearer 校验，前端需在 localStorage 存 token。
# ADMIN_TOKEN=

# ---- 审计追溯 ----
# AUDIT_RETENTION_DAYS=30
# AUDIT_PHOTO_DIR=            # 留空则用 backend/data/audit_photos
# AUDIT_MAX_DIMENSION=1280    # 原始摄像头帧约 1.5MB，按此参数压到约 150KB
# AUDIT_JPEG_QUALITY=82
# AUDIT_AUTO_PURGE=true
# AUDIT_PURGE_INTERVAL_HOURS=1

# ---- 提示词热重载 ----
# 开：每次取提示词 stat 一次文件，mtime 变了就重读（开发态好用）
# 关：进程内缓存，改了要重启（生产默认）
# PROMPT_HOT_RELOAD=false

# ---- 数据库 ----
# 留空则用 backend/data/smartmart.db（SQLite）
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/smartmart
